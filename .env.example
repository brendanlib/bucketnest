# Copy to .env and fill in. Never commit .env.

APP_PORT=8080
# The address people use to open the app. Used for email links and origin checks.
PUBLIC_URL=https://budget.example.com
# Reverse proxies in front of the app (1 for Nginx Proxy Manager, Traefik or Cloudflare Tunnel).
TRUST_PROXY=1

POSTGRES_DB=budget
POSTGRES_USER=budget
POSTGRES_PASSWORD=change-me   # openssl rand -hex 24 (URL-safe)

SESSION_SECRET=change-me      # openssl rand -hex 32
ALLOW_REGISTRATION=           # blank = open only until the first user
COOKIE_SECURE=true            # set false only for plain-HTTP testing on a LAN
DEFAULT_TIMEZONE=Australia/Sydney

# Optional: email for password resets. Without it, use the reset-password CLI.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

SEED_DEMO=false
LOG_LEVEL=info
BACKUP_RETENTION=14

# Optional: Cloudflare Tunnel token for `docker compose --profile tunnel up -d`
CLOUDFLARE_TUNNEL_TOKEN=
