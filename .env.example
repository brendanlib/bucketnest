# Copy to .env and fill in. Never commit .env.

APP_PORT=8080
# 127.0.0.1 when a reverse proxy (Caddy, nginx) runs on this same server;
# 0.0.0.0 when the proxy is another machine. Docker-published ports bypass ufw.
APP_BIND=0.0.0.0
# The address people use to open the app. Used for email links and origin checks.
PUBLIC_URL=https://budget.example.com
# Reverse proxies in front of the app (1 for Caddy, Nginx Proxy Manager, Traefik or Cloudflare Tunnel).
TRUST_PROXY=1

POSTGRES_DB=budget
POSTGRES_USER=budget
# openssl rand -hex 24 (hex is URL-safe)
POSTGRES_PASSWORD=change-me

# openssl rand -hex 32. Changing it signs everyone out and disconnects bank feeds.
SESSION_SECRET=change-me
# Blank: anyone can register until the first account exists, then only by invite.
# true: always open. false: always closed (invites still work).
ALLOW_REGISTRATION=
# Set false only for plain-HTTP testing on a LAN.
COOKIE_SECURE=true
DEFAULT_TIMEZONE=Australia/Sydney

# Optional: email for password resets and alerts. Without it, use the reset-password CLI.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Demo household (demo@example.com) on a first start with an empty database.
# Without DEMO_PASSWORD a random one is printed in `docker compose logs backend`.
SEED_DEMO=false
DEMO_PASSWORD=
LOG_LEVEL=info
BACKUP_RETENTION=14

# Optional: Cloudflare Tunnel token for `docker compose --profile tunnel up -d`
CLOUDFLARE_TUNNEL_TOKEN=
