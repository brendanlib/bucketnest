{
  "name": "home-budget-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && cp src/seed/common-passwords.txt dist/seed/",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:finance": "vitest run src/finance",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "reset-password": "node dist/cli/reset-password.js",
    "prisma:migrate:dev": "prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "decimal.js": "^10.6.0",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^6.1.0",
    "nodemailer": "^7.0.13",
    "prisma": "6.19.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "3.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "cpu-features": false,
    "ssh2": false,
    "protobufjs": false
  }
}
